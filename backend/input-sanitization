// ============================================================
// SANITIZATION TEST CASES
// ============================================================

export const SANITIZATION_TEST_CASES = [

  {
    name: 'Plain text',
    input: 'Hello world',
    expected: 'Hello world',
  },

  {
    name: 'Newline preservation',
    input: 'Hello\nWorld',
    expected: 'Hello\nWorld',
  },

  {
    name: 'Tab preservation',
    input: 'Name\tAge\tCountry',
    expected: 'Name\tAge\tCountry',
  },

  {
    name: 'Multi-line tabular data',
    input:
      'Name\tAge\nJohn\t25\nJane\t30',
    expected:
      'Name\tAge\nJohn\t25\nJane\t30',
  },

  {
    name: 'Carriage return preservation',
    input: 'First\r\nSecond',
    expected: 'First\r\nSecond',
  },

  {
    name: 'Null byte removal',
    input: 'Hello\0World',
    expected: 'HelloWorld',
  },

  {
    name: 'Bell character removal',
    input: 'Hello\x07World',
    expected: 'HelloWorld',
  },

  {
    name: 'Escape control character removal',
    input: 'Hello\x1bWorld',
    expected: 'HelloWorld',
  },

  {
    name: 'Mixed formatting',
    input:
      'Title\n\tIndented content\n\tMore content',
    expected:
      'Title\n\tIndented content\n\tMore content',
  },

];

// ============================================================
// SELF TEST
// ============================================================

export function runSanitizationTests(): void {

  for (
    const test
    of SANITIZATION_TEST_CASES
  ) {

    const actual =
      sanitizeText(test.input);

    if (
      actual !== test.expected
    ) {

      throw new Error(
        `Sanitization test failed: ${test.name}`,
      );
    }
  }
}

// ============================================================
// SECURITY NOTES
// ============================================================

/*
 * IMPORTANT:
 *
 * Sanitization is NOT a replacement for validation,
 * authorization, encoding, or parameterized database queries.
 *
 * This middleware only addresses unwanted control characters.
 *
 * It should NOT be used as the primary defense against:
 *
 * - SQL injection
 * - XSS
 * - CSRF
 * - command injection
 * - path traversal
 * - authentication bypass
 *
 * Those concerns should be handled by their appropriate
 * security controls.
 *
 * The purpose of this middleware is specifically to avoid
 * corrupting legitimate structured input while removing
 * characters that the application does not support.
 */

