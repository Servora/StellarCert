# Copy to .env before running `docker compose up`.
#
# Every value below is required by docker-compose.yml, which fails fast with
# `${VAR:?}` when one is missing or empty. The JWT placeholders are deliberately
# longer than 32 characters: environment.config.ts rejects anything shorter in
# production. Replace them with real secrets before deploying.

# Database Configuration
POSTGRES_DB=stellarwave
POSTGRES_USER=stellarwave_user
POSTGRES_PASSWORD=stellarwave_password

# Redis Configuration (required - Redis runs with --requirepass)
REDIS_PASSWORD=stellarwave_redis_password

# Backend Configuration
NODE_ENV=production
PORT=3000
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=stellarwave_user
DB_NAME=stellarwave

# JWT Configuration (all three are required in production, >= 32 characters)
JWT_SECRET=change-me-local-jwt-secret-at-least-32-chars
JWT_ACCESS_SECRET=change-me-local-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-local-refresh-secret-at-least-32-chars
JWT_EXPIRES_IN=3600

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://frontend:5173
CORS_ORIGIN=http://localhost:5173,http://frontend:5173

# Stellar Configuration
STELLAR_NETWORK=TESTNET
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_ISSUER_SECRET_KEY=SAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
STELLAR_ISSUER_PUBLIC_KEY=GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAWHF

# Storage Configuration
# Storage (S3/MinIO) is optional by default: when STORAGE_REQUIRED is absent or
# false the app starts and only logs a warning if the S3 config is missing.
STORAGE_REQUIRED=false

# Logging Configuration
LOG_LEVEL=info

# Monitoring Configuration
METRICS_ENABLED=true
SENTRY_DSN=

# Frontend Configuration (browser-reachable URL, includes the /v1 API prefix)
VITE_API_URL=http://localhost:3000/api/v1
VITE_STELLAR_NETWORK=TESTNET
VITE_HORIZON_URL=https://horizon-testnet.stellar.org
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_METRICS=true
