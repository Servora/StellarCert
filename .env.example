# Copy to .env before running `docker compose up`.
#
# Every value below is required by docker-compose.yml, which fails fast with
# `${VAR:?}` when one is missing or empty. The JWT placeholders are deliberately
# longer than 32 characters: environment.config.ts rejects anything shorter in
# production. Replace them with real secrets before deploying.

# Database Configuration
POSTGRES_DB=stellarwave
POSTGRES_USER=stellarwave_user
POSTGRES_PASSWORD=stellarwave_password

# Postgres/Redis image tags (#1374). docker-compose.yml and
# docker-compose.dev.yml both default to these exact versions when unset, so
# dev and this prod-equivalent stack can't silently drift onto different
# patch versions; override here to bump both at once. ci.yml pins the same
# versions directly, since GitHub Actions service containers don't read this
# file.
POSTGRES_IMAGE=postgres:15.19-alpine
REDIS_IMAGE=redis:7.4.11-alpine

# Redis Configuration (required - Redis runs with --requirepass)
REDIS_PASSWORD=stellarwave_redis_password

# Backend Configuration
NODE_ENV=production
PORT=3000
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=stellarwave_user
DB_NAME=stellarwave

# Local Compose Postgres does not use TLS. Set DB_SSL=true for a managed
# PostgreSQL provider; optionally provide its PEM CA in DB_SSL_CA (with \n
# escapes for line breaks). The CA is verified and requires DB_SSL=true.
DB_SSL=false
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# JWT Configuration (all three are required in production, >= 32 characters)
JWT_SECRET=change-me-local-jwt-secret-at-least-32-chars
JWT_ACCESS_SECRET=change-me-local-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-local-refresh-secret-at-least-32-chars
JWT_EXPIRES_IN=3600

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://frontend:5173
CORS_ORIGIN=http://localhost:5173,http://frontend:5173

# Public app URL — the base for links in emails, QR codes and PDFs (#1242).
# Must be reachable by certificate recipients; no trailing slash.
# APP_URL is a deprecated alias, read only when FRONTEND_URL is unset.
FRONTEND_URL=http://localhost:5173

# Stellar Configuration
# These are real, throwaway testnet keys generated for this example — the SDK
# validates CRC16 checksums, so placeholder strings like SAAA...AAA or GAAA...WHF
# decode correctly at the string level but fail the checksum and cause a silent
# "Invalid key" error at startup. Replace both values with the output of:
#   node -e "const {Keypair}=require('@stellar/stellar-sdk'); const k=Keypair.random(); console.log(k.secret(), k.publicKey())"
# then fund the public key on testnet via https://friendbot.stellar.org/?addr=<PUBLIC_KEY>
# Never reuse these example keys: they are public and their private key is known.
STELLAR_NETWORK=TESTNET
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_ISSUER_SECRET_KEY=SDZK5OV3VIYQ5DAYPD5TYQDNWF46XVFP227GZD6V4ZVH5BFP3VJXAW5U
STELLAR_ISSUER_PUBLIC_KEY=GCXERQWZDON4Y3PFI5PSMJK2UANBHXAL2GQWBKNRXOSUVFCFT2WRIW43

# Storage Configuration
# Storage (S3/MinIO) is optional by default: when STORAGE_REQUIRED is absent or
# false the app starts and only logs a warning if the S3 config is missing.
STORAGE_REQUIRED=false

# Logging Configuration
LOG_LEVEL=info

# Monitoring Configuration
METRICS_ENABLED=true
SENTRY_DSN=

# Frontend Configuration (browser-reachable URL, includes the /v1 API prefix)
VITE_API_URL=http://localhost:3000/api/v1
VITE_STELLAR_NETWORK=TESTNET
VITE_HORIZON_URL=https://horizon-testnet.stellar.org
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_METRICS=true
