{
  "name": "stellarcert-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:e2e:seed": "node e2e/seed.mjs",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc -b",
    "check:import-case": "node scripts/check-import-case.mjs",
    "check:api-routes": "node scripts/check-api-routes.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.3",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.73.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.20.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^16.5.0",
    "jsdom": "^22.1.0",
    "pg": "^8.13.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
